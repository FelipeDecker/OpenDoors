@page "/tickets-diarios/novo"
@using System.ComponentModel.DataAnnotations
@inject ITicketDiariosClient TicketDiariosClient
@inject IMoradoresClient MoradoresClient
@inject IEnumsClient EnumsClient
@inject NavigationManager NavigationManager

<PageTitle>Novo ticket diário</PageTitle>

<h1>Novo ticket diário</h1>

@if (mensagemErro is not null)
{
    <div class="alert alert-danger" role="alert">
        @mensagemErro
    </div>
}

@if (carregandoMoradores)
{
    <p>Carregando moradores...</p>
}
else
{
    <EditForm Model="modelo" OnValidSubmit="AdicionarAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label for="morador" class="form-label">Morador</label>
            <InputSelect id="morador" class="form-select" @bind-Value="modelo.MoradorId">
                <option value="0">Selecione um morador</option>
                @foreach (var morador in moradores)
                {
                    <option value="@morador.Id">@morador.NomeCompleto</option>
                }
            </InputSelect>
        </div>

        <div class="mb-3">
            <label for="dataServico" class="form-label">Data do serviço</label>
            <InputDate id="dataServico" class="form-control" @bind-Value="dataServico" />
        </div>

        <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center">
                <label class="form-label mb-0">Serviços</label>
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AdicionarServico" disabled="@(!PodeAdicionarServico)">Adicionar serviço</button>
            </div>

            @if (!PodeAdicionarServico)
            {
                <p class="text-muted mt-2">Quantidade máxima de serviços atingida.</p>
            }

            @if (modelo.Servicos.Count == 0)
            {
                <p class="text-muted mt-2">Nenhum serviço adicionado.</p>
            }
            else
            {
                <table class="table table-sm align-middle mt-2">
                    <thead>
                        <tr>
                            <th>Serviço</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var servico in modelo.Servicos)
                        {
                            <tr @key="servico">
                                <td>
                                    <InputSelect class="form-select" @bind-Value="servico.ServicoTicket">
                                        @foreach (var nomeServico in ServicosDisponiveisPara(servico))
                                        {
                                            <option @key="nomeServico" value="@nomeServico">@ObterNomeServico(nomeServico)</option>
                                        }
                                    </InputSelect>
                                </td>
                                <td>
                                    <InputSelect class="form-select" @bind-Value="servico.Status">
                                        @foreach (var status in Enum.GetValues<ServicoStatusEnum>())
                                        {
                                            <option value="@status">@ObterNomeStatus(status)</option>
                                        }
                                    </InputSelect>
                                </td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoverServico(servico)">Remover</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <button type="submit" class="btn btn-primary" disabled="@salvando">Adicionar</button>
        <button type="button" class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
    </EditForm>
}

@code {
    private TicketDiarioModel modelo = new();
    private ICollection<MoradorModel> moradores = [];
    private Dictionary<int, string> nomesServicoTicket = new();
    private Dictionary<int, string> nomesServicoStatus = new();
    private DateTime dataServico = DateTime.Today;
    private bool carregandoMoradores = true;
    private bool salvando;
    private string? mensagemErro;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            moradores = await MoradoresClient.GetAsync();

            var servicosTicket = await EnumsClient.GetServicosTicketAsync();
            nomesServicoTicket = servicosTicket.ToDictionary(item => item.Id, item => item.Nome);

            var servicosStatus = await EnumsClient.GetServicosStatusAsync();
            nomesServicoStatus = servicosStatus.ToDictionary(item => item.Id, item => item.Nome);
        }
        catch (Exception)
        {
            mensagemErro = "Não foi possível carregar os moradores.";
        }
        finally
        {
            carregandoMoradores = false;
        }
    }

    private string ObterNomeServico(ServicoTicketEnum servico) =>
        nomesServicoTicket.TryGetValue((int)servico, out var nome) ? nome : servico.ToString();

    private string ObterNomeStatus(ServicoStatusEnum status) =>
        nomesServicoStatus.TryGetValue((int)status, out var nome) ? nome : status.ToString();

    private static readonly int TotalServicosDisponiveis = Enum.GetValues<ServicoTicketEnum>().Length;

    private bool PodeAdicionarServico => modelo.Servicos.Count < TotalServicosDisponiveis;

    private void AdicionarServico()
    {
        if (!PodeAdicionarServico)
        {
            return;
        }

        var servicosUtilizados = modelo.Servicos.Select(s => s.ServicoTicket).ToHashSet();
        var proximoServico = Enum.GetValues<ServicoTicketEnum>().First(s => !servicosUtilizados.Contains(s));

        modelo.Servicos.Add(new TicketServicoModel
        {
            ServicoTicket = proximoServico,
            Status = ServicoStatusEnum.Pendente
        });
    }

    private void RemoverServico(TicketServicoModel servico)
    {
        modelo.Servicos.Remove(servico);
    }

    private IEnumerable<ServicoTicketEnum> ServicosDisponiveisPara(TicketServicoModel servico)
    {
        var servicosUtilizadosPorOutros = modelo.Servicos
            .Where(s => s != servico)
            .Select(s => s.ServicoTicket)
            .ToHashSet();

        return Enum.GetValues<ServicoTicketEnum>()
            .Where(s => s == servico.ServicoTicket || !servicosUtilizadosPorOutros.Contains(s));
    }

    private async Task AdicionarAsync()
    {
        if (modelo.MoradorId <= 0)
        {
            mensagemErro = "Selecione um morador.";
            return;
        }

        if (modelo.Servicos.Count == 0)
        {
            mensagemErro = "Adicione ao menos um serviço.";
            return;
        }

        salvando = true;
        mensagemErro = null;
        try
        {
            modelo.DataServico = new DateTimeOffset(dataServico);
            await TicketDiariosClient.CreateAsync(modelo);
            NavigationManager.NavigateTo("/tickets-diarios");
        }
        catch (Exception)
        {
            mensagemErro = "Não foi possível adicionar o ticket diário.";
        }
        finally
        {
            salvando = false;
        }
    }

    private void Cancelar()
    {
        NavigationManager.NavigateTo("/tickets-diarios");
    }
}
