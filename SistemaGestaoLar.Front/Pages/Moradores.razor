@page "/moradores"
@inject IMoradoresClient MoradoresClient
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Moradores</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Moradores</h1>
    <button type="button" class="btn btn-primary" @onclick="NovoMorador">Novo morador</button>
</div>

@if (carregando)
{
    <p>Carregando moradores...</p>
}
else if (mensagemErro is not null)
{
    <div class="alert alert-danger" role="alert">
        @mensagemErro
    </div>
}
else if (moradores.Count == 0)
{
    <p>Nenhum morador cadastrado.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th scope="col">Nome completo</th>
                    <th scope="col">Data de nascimento</th>
                    <th scope="col">Contato de emergência</th>
                    <th scope="col">Observações</th>
                    <th scope="col">Histórico de acolhimento</th>
                    <th scope="col">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var morador in moradores)
                {
                    <tr>
                        <td>@morador.NomeCompleto</td>
                        <td>@morador.DataNascimento.ToString("dd/MM/yyyy")</td>
                        <td>@morador.ContatoEmergencia</td>
                        <td>@morador.Observacoes</td>
                        <td>@morador.HistoricoAcolhimento</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditarMorador(morador.Id)">Editar</button>
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => ExcluirMoradorAsync(morador)">Excluir</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private ICollection<MoradorModel> moradores = [];
    private bool carregando = true;
    private string? mensagemErro;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            moradores = await MoradoresClient.GetAsync();
        }
        catch (Exception)
        {
            mensagemErro = "Não foi possível carregar os moradores.";
        }
        finally
        {
            carregando = false;
        }
    }

    private void NovoMorador()
    {
        NavigationManager.NavigateTo("/moradores/novo");
    }

    private void EditarMorador(int id)
    {
        NavigationManager.NavigateTo($"/moradores/editar/{id}");
    }

    private async Task ExcluirMoradorAsync(MoradorModel morador)
    {
        var confirmado = await JSRuntime.InvokeAsync<bool>("confirm", $"Deseja realmente excluir o morador \"{morador.NomeCompleto}\"?");
        if (!confirmado)
        {
            return;
        }

        try
        {
            await MoradoresClient.DeleteAsync(morador.Id);
            moradores.Remove(morador);
        }
        catch (Exception)
        {
            mensagemErro = "Não foi possível excluir o morador.";
        }
    }
}
