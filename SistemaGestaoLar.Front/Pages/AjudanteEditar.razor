@page "/ajudantes/editar/{Id:int}"
@using System.ComponentModel.DataAnnotations
@inject IAjudantesClient AjudantesClient
@inject NavigationManager NavigationManager

<PageTitle>Editar ajudante</PageTitle>

<h1>Editar ajudante</h1>

@if (carregando)
{
    <p>Carregando ajudante...</p>
}
else if (mensagemErro is not null)
{
    <div class="alert alert-danger" role="alert">
        @mensagemErro
    </div>
}
else
{
    <EditForm Model="modelo" OnValidSubmit="SalvarAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label for="nome" class="form-label">Nome</label>
            <InputText id="nome" class="form-control" @bind-Value="modelo.Nome" />
        </div>

        <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <InputText id="email" class="form-control" @bind-Value="modelo.Email" />
        </div>

        <div class="mb-3">
            <label for="telefone" class="form-label">Telefone</label>
            <InputText id="telefone" class="form-control" @bind-Value="modelo.Telefone" />
        </div>

        <div class="mb-3">
            <label for="disponibilidade" class="form-label">Disponibilidade</label>
            <InputText id="disponibilidade" class="form-control" @bind-Value="modelo.Disponibilidade" />
        </div>

        <button type="submit" class="btn btn-primary" disabled="@salvando">Salvar</button>
        <button type="button" class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private AjudanteModel modelo = new();
    private bool carregando = true;
    private bool salvando;
    private string? mensagemErro;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            modelo = await AjudantesClient.GetByIdAsync(Id);
        }
        catch (Exception)
        {
            mensagemErro = "Não foi possível carregar o ajudante.";
        }
        finally
        {
            carregando = false;
        }
    }

    private async Task SalvarAsync()
    {
        salvando = true;
        mensagemErro = null;
        try
        {
            await AjudantesClient.UpdateAsync(Id, modelo);
            NavigationManager.NavigateTo("/ajudantes");
        }
        catch (Exception)
        {
            mensagemErro = "Não foi possível salvar o ajudante.";
        }
        finally
        {
            salvando = false;
        }
    }

    private void Cancelar()
    {
        NavigationManager.NavigateTo("/ajudantes");
    }
}
