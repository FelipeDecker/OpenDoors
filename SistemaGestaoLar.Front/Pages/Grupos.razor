@page "/grupos"
@inject IGruposClient GruposClient
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Grupos</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Grupos</h1>
    <button type="button" class="btn btn-primary" @onclick="NovoGrupo">Novo grupo</button>
</div>

@if (carregando)
{
    <p>Carregando grupos...</p>
}
else if (mensagemErro is not null)
{
    <div class="alert alert-danger" role="alert">
        @mensagemErro
    </div>
}
else if (grupos.Count == 0)
{
    <p>Nenhum grupo cadastrado.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th scope="col">Nome</th>
                    <th scope="col">Descrição</th>
                    <th scope="col">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var grupo in grupos)
                {
                    <tr>
                        <td>@grupo.Nome</td>
                        <td>@grupo.Descricao</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-secondary me-1" @onclick="() => AjudantesDoGrupo(grupo.Id)">Ajudantes</button>
                            <button type="button" class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditarGrupo(grupo.Id)">Editar</button>
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => ExcluirGrupoAsync(grupo)">Excluir</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private ICollection<GrupoModel> grupos = [];
    private bool carregando = true;
    private string? mensagemErro;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            grupos = await GruposClient.GetAsync();
        }
        catch (Exception)
        {
            mensagemErro = "Não foi possível carregar os grupos.";
        }
        finally
        {
            carregando = false;
        }
    }

    private void NovoGrupo()
    {
        NavigationManager.NavigateTo("/grupos/novo");
    }

    private void EditarGrupo(int id)
    {
        NavigationManager.NavigateTo($"/grupos/editar/{id}");
    }

    private void AjudantesDoGrupo(int id)
    {
        NavigationManager.NavigateTo($"/grupos/{id}/ajudantes");
    }

    private async Task ExcluirGrupoAsync(GrupoModel grupo)
    {
        var confirmado = await JSRuntime.InvokeAsync<bool>("confirm", $"Deseja realmente excluir o grupo \"{grupo.Nome}\"?");
        if (!confirmado)
        {
            return;
        }

        try
        {
            await GruposClient.DeleteAsync(grupo.Id);
            grupos.Remove(grupo);
        }
        catch (Exception)
        {
            mensagemErro = "Não foi possível excluir o grupo.";
        }
    }
}
